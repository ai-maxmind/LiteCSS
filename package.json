  "bugs": {
    "url": "https://github.com/ai-maxmind/LiteCSS/issues"
  },
  "homepage": "https://github.com/ai-maxmind/LiteCSS#readme",
  "devDependencies": {
    "@babel/cli": "^7.27.1",
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.1",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "core-js": "^3.42.0",
    "cssnano": "^7.0.6",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "rollup": "^2.79.2",
