{
  "name": "litecss",
  "version": "1.0.0",
  "description": "The best HTML, CSS, and JavaScript framework for developing responsive, mobile first projects on the web.",
  "main": "postcss.config.js",
  "scripts": {
    "build:babel": "babel js --out-dir lib --source-maps",
    "build:webpack": "webpack --config webpack.config.js",
    "build:rollup": "rollup -c rollup.config.js",
    "build": "npm run build:babel && npm run build:webpack && npm run build:rollup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-maxmind/LiteCSS.git"
  },
